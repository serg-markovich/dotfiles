export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"

plugins=(git docker kubectl helm terraform direnv fzf z)

source $ZSH/oh-my-zsh.sh

# Aliases
alias k='kubectl'
alias kx='kubectx'
alias kn='kubens'
alias tf='terraform'
alias dc='docker compose'
alias ll='ls -la'
alias cat='bat --style=plain'
alias bat='batcat --style=plain'

# direnv hook
eval "$(direnv hook zsh)"

# fzf
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# Load project-specific env vars
[ -f "$HOME/eigenbase/.env" ] && source "$HOME/eigenbase/.env"

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# Load local secrets (never committed, see .chezmoiignore)
[ -f ~/.secrets ] && source ~/.secrets

# OpenRouter routing for Claude Code
export ANTHROPIC_BASE_URL="https://openrouter.ai/api"
export ANTHROPIC_AUTH_TOKEN="$OPENROUTER_API_KEY"
export ANTHROPIC_API_KEY=""   # must stay empty
export ANTHROPIC_MODEL="moonshotai/kimi-k2.7-code"

export PATH="$HOME/.local/bin:$PATH"
export PATH="/home/sergey/.kimi-code/bin:$PATH"