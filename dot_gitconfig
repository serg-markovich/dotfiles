[user]
    name = Serg Markovich
    email = me@serg-markovich.de

[core]
    editor      = code --wait
    autocrlf    = input
    excludesfile = ~/.gitignore_global

[pull]
    rebase = true

[push]
    default = current

[alias]
    st  = status
    co  = checkout
    br  = branch
    lg  = log --oneline --graph --decorate --all
    undo = reset HEAD~1 --mixed
